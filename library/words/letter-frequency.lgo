; ============================================================
; TITLE:    Letter Frequency Chart
; CATEGORY: Words & Text
; LEVEL:    Intermediate
; TAGS:     arrays, ascii, counting, bar chart, text
; SUMMARY:  Counts how often each letter A to Z appears in a passage and draws a colorful bar chart of the results.
; ============================================================
;
; WHAT IT DOES
;   Reads a passage of English, counts every letter, and draws 26
;   bars across the screen, one per letter. The tallest bar is drawn
;   in red. In most English text E, T and A win, which is the secret
;   that code breakers use to crack simple ciphers.
;
; HOW TO USE
;   Press Run. To chart your own text, change the passage at the bottom
;   or type:   chart [your words go here]
;
; CONCEPTS YOU WILL LEARN
;   * ARRAY to keep 26 counters, and SETITEM / ITEM to update them
;   * ASCII to turn a letter into a number (A is 65), and CHAR back
;   * scaling numbers so the tallest bar always fits on the screen
;   * drawing rectangles with FILLED
;
; THINGS TO TRY
;   * Chart a sentence that uses every letter (a pangram)
;   * Paste in a paragraph in another language and compare the shape
;   * Sort the letters by count and print them from most to least
; ============================================================

; Add one letter to the tally. Capital and small letters count the same.
; ASCII "A is 65, so A goes in slot 1, B in slot 2 and so on.
to tally :ch
  localmake "k (ascii uppercase :ch) - 64
  if or :k < 1 :k > 26 [stop]          ; skip digits and punctuation
  setitem :k :counts 1 + item :k :counts
end

to countletters :text
  make "counts array 26
  for [i 1 26] [setitem :i :counts 0]
  ; each word of the passage, then each letter of the word
  foreach :text [foreach ? [tally ?]]
end

; The biggest number in the array; we need it to scale the bars.
to biggest
  localmake "best 0
  for [i 1 26] [if (item :i :counts) > :best [make "best item :i :counts]]
  output :best
end

; One solid bar with its bottom left corner at x, y.
to bar :x :y :w :h :color
  penup setxy :x :y setheading 0
  if :h < 1 [stop]
  filled :color [repeat 2 [forward :h right 90 forward :w right 90]]
end

to chart :text
  countletters :text
  clearscreen hideturtle
  setbackground [245 245 250]
  localmake "top biggest
  if :top = 0 [print [No letters to count!] stop]
  localmake "barw 24
  localmake "left -13 * (:barw + 4)
  ; the tallest bar is 380 steps high; the others are in proportion
  localmake "scale 380 / :top
  setlabelheight 14
  for [i 1 26] [
    localmake "n item :i :counts
    localmake "x :left + (:i - 1) * (:barw + 4)
    localmake "color ifelse :n = :top [4] [(list 40 100 + 4 * :i 230 - 5 * :i)]
    bar :x -220 :barw :n * :scale :color
    penup setpencolor 0
    setxy :x + 7 -240 label char 64 + :i
    if :n > 0 [setxy :x + 4 -215 + :n * :scale label :n]
  ]
  setxy -120 250 setlabelheight 20
  label [How often does each letter appear?]
  print (sentence [Total letters:] reduce "sum arraytolist :counts)
  for [i 1 26] [if (item :i :counts) = :top ~
    [print (sentence [Most common:] char 64 + :i [with] :top)]]
end

chart [It was the best of times it was the worst of times it was the age ~
  of wisdom it was the age of foolishness it was the epoch of belief it ~
  was the epoch of incredulity it was the season of Light it was the ~
  season of Darkness it was the spring of hope it was the winter of despair]
