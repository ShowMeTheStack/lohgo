; ============================================================
; TITLE:    A Street of Houses
; CATEGORY: Shapes & Polygons
; LEVEL:    Intermediate
; TAGS:     procedures, random, inputs, filled, picture
; SUMMARY:  Builds a whole street of different houses, each from one HOUSE procedure with random sizes and colors.
; ============================================================
;
; WHAT IT DOES
;   Houses of different widths, heights and colors line up along a
;   street at dusk. Tall houses get more floors of windows. Little
;   round trees stand between them. Every run makes a new street.
;
; HOW TO USE
;   Press Run again and again to build new streets. Change the
;   lists of colors to paint the town your way.
;
; CONCEPTS YOU WILL LEARN
;   * one procedure with many inputs makes many different pictures
;   * RANDOM and PICK to choose sizes and colors
;   * working out how many windows fit in a wall with INT
;   * a WHILE loop that stops when the street is full
;
; THINGS TO TRY
;   * Make all the roofs flat by drawing no roof when the house is tall.
;   * Add a door color list and PICK from it.
;   * Turn it into a night scene: dark sky and yellow windows.
; ============================================================

make "walls [[250 220 150] [240 180 170] [190 220 240] [210 230 180] [245 245 235]]
make "roofs [[170 50 50] [110 70 60] [70 90 130] [60 110 80]]
make "ground -170

to rectangle :x :y :width :height :color
  penup setxy :x :y setheading 0 pendown
  filled :color [repeat 2 [forward :height right 90 forward :width right 90]]
end

; A house whose bottom left corner is at x on the ground.
; Later drawing covers earlier drawing, so the wall is painted first
; and the windows and door go on top of it.
to house :x :width :height
  localmake "floors int (:height - 30) / 55
  localmake "across int (:width - 10) / 40
  ; windows: a grid, centered in the wall, one row per floor
  localmake "gap (:width - :across * 40) / 2
  rectangle :x :ground :width :height pick :walls
  for [f 1 :floors] [
    for [w 1 :across] [
      rectangle :x + :gap + 40 * (:w - 1) + 8 :ground + 55 * :f - 5 24 28 [255 235 140]
    ]
  ]
  rectangle :x + :width / 2 - 13 :ground 26 42 [120 70 40]
  ; the roof: a triangle that hangs a little over each side
  penup setxy :x - 8 :ground + :height pendown
  filled pick :roofs [
    setxy :x + :width / 2 :ground + :height + :width * 0.45
    setxy :x + :width + 8 :ground + :height
    setxy :x - 8 :ground + :height
  ]
end

; A lollipop tree: a big round dot on a brown stick.
to tree :x
  localmake "h 50 + random 30
  penup setpensize 8 setpencolor [110 70 40]
  setxy :x :ground pendown setxy :x :ground + :h
  penup setxy :x :ground + :h + 10
  setpensize 44 + random 16
  setpencolor (list 40 + random 40 130 + random 60 60)
  dot pos
  setpensize 2 setpencolor [70 60 60]
end

to street
  localmake "x -390
  while [:x < 300] [
    localmake "width 90 + random 70
    house :x :width 90 + random 170
    make "x :x + :width + 10
    if (random 3) = 0 [tree :x + 22 make "x :x + 45]
  ]
end

clearscreen hideturtle
setbackground [255 205 160]
setpensize 2 setpencolor [70 60 60]
street
; the road along the bottom, with a dashed white line down the middle
rectangle -400 -300 800 130 [90 90 100]
penup setxy -400 -235 setheading 90 setpencolor [250 250 250] setpensize 4
repeat 20 [pendown forward 20 penup forward 20]
