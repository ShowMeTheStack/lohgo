; ============================================================
; TITLE:    Robot Friend
; CATEGORY: Shapes & Polygons
; LEVEL:    Beginner
; TAGS:     rectangle, dot, filled, picture, coordinates
; SUMMARY:  Builds a friendly robot from colored blocks, round eyes and an antenna, then waves its arm.
; ============================================================
;
; WHAT IT DOES
;   A robot appears piece by piece: head, eyes, mouth, body,
;   buttons, arms and legs. At the end its right arm waves a few
;   times, by rubbing out the arm and drawing it again at a new angle.
;
; HOW TO USE
;   Press Run and watch. Change the colors at the top of the
;   ROBOT procedure to make your own robot.
;
; CONCEPTS YOU WILL LEARN
;   * placing shapes with x and y coordinates
;   * a BLOCK procedure with five inputs, reused for every part
;   * a big DOT makes a round eye; SETPENSIZE sets its size
;   * PENERASE rubs out lines, which makes simple animation
;
; THINGS TO TRY
;   * Give the robot three eyes.
;   * Make the legs longer by changing 90 in the two leg lines.
;   * Wave the arm more times: change 4 in WAVE.
; ============================================================

; A filled block with its bottom left corner at (x, y).
to block :x :y :width :height :color
  penup setxy :x :y setheading 0 pendown
  setpencolor [40 40 60]
  setpensize 3
  filled :color [repeat 2 [forward :height right 90 forward :width right 90]]
end

; A round dot of any size: the dot is as wide as the pen.
to bigdot :x :y :size :color
  penup setpencolor :color setpensize :size
  dot list :x :y
  setpensize 3
end

; The waving arm is just a thick line from the shoulder.
to arm :angle :color
  penup setxy 97 40 setheading :angle pendown
  ; the eraser is a little fatter than the arm so no edges are left
  setpensize ifelse penmode = "ERASE [20] [16] setpencolor :color
  forward 90
  setpensize 3
end

to robot
  ; the painted blocks first: later drawing covers earlier drawing,
  ; so the face and buttons must come after the head and body
  block -15 80 30 20 [120 130 140]        ; neck
  block -75 100 150 120 [160 190 210]     ; head
  block -85 -60 170 140 [90 140 200]      ; body
  block -60 -150 35 90 [120 130 140]      ; left leg
  block 25 -150 35 90 [120 130 140]       ; right leg
  block -75 -170 55 20 [60 60 70]         ; left foot
  block 20 -170 55 20 [60 60 70]          ; right foot
  ; eyes and mouth on top of the head
  bigdot -35 165 34 [255 255 255]
  bigdot 35 165 34 [255 255 255]
  bigdot -35 165 14 [20 20 20]
  bigdot 35 165 14 [20 20 20]
  penup setxy -30 125 setheading 90 pendown setpencolor [200 40 40] setpensize 5
  forward 60
  ; buttons on the chest
  bigdot 0 50 18 [230 60 60]
  bigdot 0 15 18 [250 200 40]
  bigdot 0 -20 18 [60 170 90]
  ; antenna: a line and a ball on top
  penup setxy 0 220 setheading 0 pendown setpencolor [40 40 60] setpensize 4
  forward 40
  bigdot 0 265 18 [230 60 60]
  ; the left arm hangs down and stays still
  penup setxy -95 40 setheading 200 pendown
  setpensize 16 setpencolor [120 130 140]
  forward 90
end

; Wave by drawing the arm, waiting, erasing it with a fat eraser
; pen, and drawing it again a bit further round.
to wave :times
  repeat :times [
    foreach [60 80 100 80] [
      arm ? [120 130 140]
      wait 8
      penerase arm ? [0 0 0] penpaint
    ]
  ]
  arm 60 [120 130 140]
end

clearscreen hideturtle
robot
wave 4
