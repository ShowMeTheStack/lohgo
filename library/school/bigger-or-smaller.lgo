; ============================================================
; TITLE:    The Hungry Crocodile
; CATEGORY: School Helpers & Quizzes
; LEVEL:    Beginner
; TAGS:     comparing, greater than, less than, symbols
; SUMMARY:  Compare two numbers with greater than, less than or equals, and watch the crocodile mouth open toward the bigger one.
; ============================================================
;
; WHAT IT DOES
;   Two numbers sit on the screen with a gap between them. You type
;   the sign that goes in the gap: > if the first is bigger, < if it is
;   smaller, = if they are the same. The hungry crocodile always opens
;   its mouth toward the bigger number, which makes the < and > signs
;   easy to remember.
;
; HOW TO USE
;   Press Run and type >, < or =. You can also type the words bigger,
;   smaller or same. QUIT stops.
;
; CONCEPTS YOU WILL LEARN
;   * GREATERP, LESSP and EQUALP, the same as > < and =
;   * drawing a mouth as two lines that meet at a point
;   * accepting more than one way to give an answer
;
; THINGS TO TRY
;   * Use numbers with decimals like 3.5 and 3.25
;   * Compare two sums, like 4 + 5 and 3 + 7
; ============================================================

to big.label :x :text
  penup setxy :x -25 setpencolor 1 setlabelheight 70 label :text
end

to croc :opens.right
  ; The open jaws point toward the bigger number.
  localmake "d ifelse :opens.right [1] [-1]
  penup setxy -40 * :d 0 setpencolor 10 setpensize 8 pendown
  setxy 40 * :d 60 penup setxy -40 * :d 0 pendown setxy 40 * :d -60 penup
  ; an eye and some teeth
  setpensize 1 setpencolor 0 setxy -20 * :d 22 pendown filled 0 [arc 360 5] penup
  setpencolor 7
  for [t 1 3] [
    setxy (-40 + :t * 20) * :d (:t * 15) - 8 pendown filled 7 [repeat 3 [fd 8 rt 120]] penup
  ]
end

to scene :a :b
  clearscreen hideturtle
  big.label -260 :a
  big.label 140 :b
  penup setxy -25 -30 setpencolor 15 setlabelheight 70 label "?
end

to answer.sign
  localmake "a readword
  if or emptyp :a memberp :a [quit stop q] [output "quit]
  if memberp :a [> bigger greater more] [output ">]
  if memberp :a [< smaller less fewer] [output "<]
  if memberp :a [= same equal] [output "=]
  print [Type > or < or =]
  output answer.sign
end

to truth :a :b
  if :a > :b [output ">]
  if :a < :b [output "<]
  output "=
end

make "score 0
catch "finished [
  repeat 8 [
    localmake "a random 50
    ; sometimes make them equal, so = gets a turn too
    localmake "b ifelse (random 5) = 0 [:a] [random 50]
    scene :a :b
    print (sentence [What goes between] :a [and] word :b "?)
    localmake "s answer.sign
    if equalp :s "quit [throw "finished]
    localmake "t truth :a :b
    clearscreen hideturtle big.label -260 :a big.label 140 :b
    ifelse equalp :t "= [penup setxy -25 -30 setpencolor 4 setlabelheight 70 label "=] [croc equalp :t "<]
    ifelse equalp :s :t [print [Correct!] make "score :score + 1] [print (sentence [It is] :a :t :b)]
    wait 60
  ]
]
print (sentence [Score:] :score)
