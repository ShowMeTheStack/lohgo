; ============================================================
; TITLE:    Counting Sort Tally
; CATEGORY: Algorithms
; LEVEL:    Intermediate
; TAGS:     sorting, counting, arrays, histogram
; SUMMARY:  Sorts digits without ever comparing two of them, by tallying how many of each digit there are.
; ============================================================
;
; WHAT IT DOES
;   A row of 24 random digits appears at the top. The turtle arrow
;   points at each digit in turn, and that digit drops a colored block
;   onto its own tally column in the middle, so the columns grow into a
;   bar chart. Then the columns are read from 0
;   to 9 and the digits are written out in order along the bottom.
;
; HOW TO USE
;   Press Run. Change :how.many (up to 24 fits nicely) or :delay.
;
; CONCEPTS YOU WILL LEARN
;   * an array whose origin is 0, made with (ARRAY 10 0)
;   * moving the turtle as a pointer instead of redrawing
;   * using a value as an index into another array
;   * why counting sort beats comparison sorts when values are small
;
; THINGS TO TRY
;   * Let values go up to 15 by making the counts array bigger.
;   * Print the counts array with SHOW before writing the output.
;   * Why would this be a bad way to sort numbers up to a million?
; ============================================================

make "how.many 24
make "delay 6

; Palette colors 1 to 10 make each digit easy to recognize.
to digit.color :d
  output item :d + 1 [4 14 6 10 2 11 1 13 5 12]
end

; A 26 by 26 square with the digit printed in the middle.
to tile :x :y :d :colr
  penup setxy :x :y setheading 0 pendown
  filled :colr [repeat 4 [forward 26 right 90]]
  penup setxy :x + 9 :y + 7
  setpencolor "white
  label :d
end

; Drawn once. Instead of recoloring tiles we point at them with the turtle.
to draw.input
  for [i 1 :how.many] [
    tile -330 + (:i - 1) * 28 240 item :i :input digit.color item :i :input
  ]
end

; Park the turtle just under input tile i, pointing up at it.
to point.at :i
  penup setxy -317 + (:i - 1) * 28 225 setheading 0
end

; Column d stands on y = -150 at x = -270 + 56 d.
to tally.block :d :level
  tile -270 + 56 * :d -150 + 27 * :level :d digit.color :d
end

to counting.sort
  ; counts is numbered 0 to 9 so a digit can be used as its own index
  make "counts (array 10 0)
  for [d 0 9] [setitem :d :counts 0]
  for [i 1 :how.many] [
    localmake "d item :i :input
    point.at :i
    wait :delay
    tally.block :d item :d :counts
    setitem :d :counts 1 + item :d :counts
  ]
  hideturtle
  ; Read the columns from left to right and write out the result.
  localmake "spot 0
  for [d 0 9] [
    repeat item :d :counts [
      tile -330 + :spot * 28 -260 :d digit.color :d
      make "spot :spot + 1
      wait :delay
    ]
  ]
end

clearscreen hideturtle
setbackground "#1c1c24
setlabelheight 14
make "input array :how.many
for [i 1 :how.many] [setitem :i :input random 10]
; labels under the tally columns
setpencolor "white
for [d 0 9] [penup setxy -264 + 56 * :d -175 label :d]
draw.input
setshape "arrow setpencolor "white showturtle
counting.sort
print [Sorted without a single comparison.]
