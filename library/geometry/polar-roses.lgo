; ============================================================
; TITLE:    Polar Roses
; CATEGORY: Geometry & Trigonometry
; LEVEL:    Intermediate
; TAGS:     polar coordinates, cosine, curves, flowers
; SUMMARY:  Draws six rose curves r = cos(k * angle) using polar coordinates and labels each with its k.
; ============================================================
;
; WHAT IT DOES
;   Six flowers appear in two rows. Each one is made by sweeping an
;   angle round and round, and at every angle moving out a distance
;   r = cos(k * angle) from the center. Whole numbers k give simple
;   roses; fractions like 3/2 give petals that overlap.
;
; HOW TO USE
;   Press Run. Edit the list in the last line to try your own k values.
;   Each entry is [top bottom], so [7 3] means k = 7/3.
;
; CONCEPTS YOU WILL LEARN
;   * polar coordinates: a point given by an angle and a distance
;   * turning polar into x and y: x = r*cos(a), y = r*sin(a)
;   * an odd k gives k petals, an even k gives 2*k petals
;   * a fraction top/bottom needs bottom full turns to close up
;
; THINGS TO TRY
;   * Swap COS for SIN in the formula. What changes?
;   * Try [1 1] and [1 2]. Are those roses at all?
;   * Use one big rose in the middle with k = 7/5.
; ============================================================

; Draw the rose r = size * cos(k * a) around cx cy, where k = top/bottom.
to rose :top :bottom :size :cx :cy :color
  localmake "k :top / :bottom
  localmake "turns 360 * :bottom
  setpensize 2 setpencolor :color
  penup setxy :cx + :size :cy pendown
  for [a 0 :turns 2] [
    localmake "r :size * cos (:k * :a)
    setxy :cx + :r * cos :a :cy + :r * sin :a
  ]
  penup
  ; the label underneath
  setxy :cx - 30 :cy - :size - 30 setpencolor "black
  label ifelse :bottom = 1 [word "k= :top] [(word "k= :top "/ :bottom)]
end

to garden :pairs
  localmake "colors [[220 40 90] [240 120 0] [40 140 60] [40 80 200] [140 50 170] [0 140 150]]
  localmake "i 0
  foreach :pairs [
    make "i :i + 1
    ; three per row, 250 steps apart
    localmake "cx -250 + 250 * remainder (:i - 1) 3
    localmake "cy ifelse :i <= 3 [140] [-130]
    rose first ? last ? 100 :cx :cy item :i :colors
  ]
end

clearscreen hideturtle
setbackground [255 252 245]
setlabelheight 18
garden [[2 1] [3 1] [5 1] [3 2] [5 3] [7 4]]
