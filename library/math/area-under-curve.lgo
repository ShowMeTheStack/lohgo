; ============================================================
; TITLE:    Area Under a Curve
; CATEGORY: Mathematics
; LEVEL:    Advanced
; TAGS:     calculus, riemann sums, area, approximation, animation
; SUMMARY:  Estimates the area under y = x*x with thinner and thinner rectangles until it closes in on the exact answer 9.
; ============================================================
;
; WHAT IT DOES
;   How much space is there between the curve y = x*x and the x axis,
;   from x = 0 to x = 3? Chop it into rectangles and add up their
;   areas. With a few wide rectangles the answer is rough; with many
;   thin ones it gets very close. The animation uses 3, 6, 12, 24 and
;   then 48 rectangles, each the height of the curve at its middle
;   (the midpoint rule). The exact answer, found with calculus, is 9.
;
; HOW TO USE
;   Press Run and watch. Change :method to "left or "right to make
;   each rectangle as tall as the curve at its left or right edge.
;
; CONCEPTS YOU WILL LEARN
;   * approximating a curved shape with simple pieces
;   * adding up a sum in a loop (a Riemann sum)
;   * why the error shrinks as the pieces get thinner
;   * CLEAN to redraw each frame of an animation
;
; THINGS TO TRY
;   * Compare the error of "left, "right and "mid with 48 rectangles.
;   * Change F to output :x * :x * :x. The exact answer is 81/4.
;   * Double the number of rectangles: how much smaller does the
;     error get for each method?
; ============================================================

make "method "mid
make "a 0
make "b 3
make "xscale 200
make "yscale 40

; The curve we are measuring.
to f :x
  output :x * :x
end

to sx :x
  output -300 + :x * :xscale
end
to sy :y
  output -230 + :y * :yscale
end

; Where along each strip do we measure the height?
to sample :left :width
  if :method = "left [output :left]
  if :method = "right [output :left + :width]
  output :left + :width / 2
end

to axes
  setpencolor [90 90 90] setpensize 2
  penup setxy sx -0.2 sy 0 pendown setxy sx 3.4 sy 0
  penup setxy sx 0 sy -0.3 pendown setxy sx 0 sy 10.5
  setlabelheight 12
  for [i 1 3] [penup setxy (sx :i) - 3 (sy 0) - 18 label :i]
  for [j 2 10 2] [penup setxy (sx 0) - 22 (sy :j) - 4 label :j]
end

to curve
  setpencolor [200 40 60] setpensize 3
  penup setxy sx 0 sy f 0 pendown
  for [i 1 110] [localmake "x 3.3 * :i / 110 setxy sx :x sy f :x]
end

; Draw n rectangles and output the total of their areas.
to strips :n
  localmake "width (:b - :a) / :n
  localmake "total 0
  for [k 0 :n - 1] [
    localmake "left :a + :k * :width
    localmake "h f sample :left :width
    make "total :total + :h * :width
    penup setxy sx :left sy 0 setheading 0
    filled [150 200 240] [rectangle :width * :xscale :h * :yscale]
    setpencolor [40 90 160] setpensize 1 pendown
    rectangle :width * :xscale :h * :yscale
  ]
  output :total
end

to rectangle :w :h
  repeat 2 [forward :h right 90 forward :w right 90]
end

to frame :n
  clean
  localmake "total strips :n
  axes
  curve
  penup setxy -380 260 setpencolor "black setlabelheight 18
  label (sentence :n [rectangles: area is about] form :total 0 4)
  setxy -380 235 setlabelheight 14 setpencolor [90 90 90]
  label (sentence [the exact area is 9, so the error is] form :total - 9 0 4)
  print (sentence form :n 3 0 [rectangles:] form :total 8 4 [error] form :total - 9 8 4)
end

clearscreen hideturtle
print (sentence [Using the] :method [rule, from x =] :a [to x =] :b)
foreach [3 6 12 24 48] [frame ? wait 90]
