; ============================================================
; TITLE:    Fraction Calculator
; CATEGORY: Mathematics
; LEVEL:    Intermediate
; TAGS:     fractions, gcd, lists, arithmetic, bars
; SUMMARY:  Adds, subtracts, multiplies and divides fractions kept as [numerator denominator] lists, and draws them as bars.
; ============================================================
;
; WHAT IT DOES
;   A fraction like 3/4 is stored as the list [3 4]. The program
;   teaches Logo the four operations on such lists, always reducing
;   the answer to lowest terms with Euclid's GCD. It prints a set of
;   worked examples, then draws 1/2 + 1/3 = 5/6 as fraction bars so
;   you can see why the common denominator is 6.
;
; HOW TO USE
;   Press Run. Try your own sums at the command center, for example
;     show fadd [2 3] [3 4]
;     print fshow fdiv [1 2] [3 8]
;
; CONCEPTS YOU WILL LEARN
;   * representing a new kind of number as a list
;   * writing procedures that output lists
;   * the greatest common divisor, found by Euclid's method
;   * the rules for adding, multiplying and dividing fractions
;
; THINGS TO TRY
;   * Change the drawing at the bottom to show [3 4] and [1 6].
;   * Add a procedure FLESS that tells whether one fraction is smaller.
;   * What does fadd [1 2] [1 2] give? Why is it [1 1] and not [2 2]?
; ============================================================

; Euclid: the GCD of a and b is the GCD of b and (a mod b).
to gcd :a :b
  if :b = 0 [output abs :a]
  output gcd :b remainder :a :b
end

to num :f
  output first :f
end
to den :f
  output last :f
end

; Make a fraction in lowest terms, with the sign kept on top.
to fraction :n :d
  localmake "g gcd :n :d
  if :d < 0 [make "g minus :g]
  output list :n / :g :d / :g
end

;  a/b + c/d = (ad + cb) / bd
to fadd :x :y
  output fraction (num :x) * (den :y) + (num :y) * (den :x) (den :x) * (den :y)
end
to fsub :x :y
  output fadd :x list minus num :y den :y
end
;  a/b * c/d = ac / bd
to fmul :x :y
  output fraction (num :x) * (num :y) (den :x) * (den :y)
end
;  dividing by c/d is multiplying by d/c
to fdiv :x :y
  output fmul :x list den :y num :y
end

; A fraction as a word for printing, like 5/6 (or just 2 for [2 1]).
to fshow :f
  if (den :f) = 1 [output num :f]
  output (word num :f "/ den :f)
end

to example :x :op :y
  localmake "answer runresult (list :op :x :y)
  localmake "sign item (position :op [fadd fsub fmul fdiv]) [+ - * /]
  print (sentence fshow :x :sign fshow :y "= fshow first :answer)
end

; Where is x in a list? MEMBER outputs the list from x onward, so
; what is left over tells us how far along x was.
to position :x :things
  output 1 + (count :things) - count member :x :things
end

; ---- drawing fraction bars ------------------------------------------
; A bar 480 steps long cut into :d equal parts, with :n parts shaded.
to fbar :f :y :color
  localmake "w 480 / den :f
  for [i 1 den :f] [
    penup setxy -240 + (:i - 1) * :w :y setheading 0
    if :i <= num :f [filled :color [part :w]]
    setpencolor [60 60 60] setpensize 2 pendown part :w
  ]
  penup setxy 260 :y + 14 setlabelheight 20 setpencolor "black label fshow :f
end
to part :w
  repeat 2 [forward 40 right 90 forward :w right 90]
end

clearscreen hideturtle
print [Fractions as lists [numerator denominator]]
print "
example [1 2] "fadd [1 3]
example [3 4] "fsub [1 6]
example [2 3] "fmul [9 10]
example [3 5] "fdiv [9 10]
example [5 8] "fadd [3 8]
example [7 12] "fsub [3 4]
print "
penup setxy -240 230 setlabelheight 18 label [Why 1/2 + 1/3 = 5/6]
fbar [1 2] 150 [250 160 60]
fbar [1 3] 80 [90 170 230]
setpencolor [90 90 90] penup setxy -240 40 setlabelheight 14
label [Cut both into sixths: 1/2 = 3/6 and 1/3 = 2/6]
fbar [3 6] -30 [250 160 60]
fbar [2 6] -100 [90 170 230]
fbar fadd [1 2] [1 3] -200 [140 110 200]
