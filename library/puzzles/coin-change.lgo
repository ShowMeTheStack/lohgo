; ============================================================
; TITLE:    Coin Change Puzzles
; CATEGORY: Puzzles & Logic
; LEVEL:    Intermediate
; TAGS:     recursion, dynamic programming, greedy, charts
; SUMMARY:  Counts the ways to make change for a dollar, then shows where "biggest coin first" goes wrong.
; ============================================================
;
; WHAT IT DOES
;   Puzzle 1: in how many ways can you make 100 cents out of half
;   dollars, quarters, dimes, nickels and pennies? A short recursive
;   procedure counts them all. (This example is famous from Abelson
;   and Sussman's book Structure and Interpretation of Computer
;   Programs.)
;   Puzzle 2: with coins of 1, 3 and 4, the shopkeeper's habit of
;   always handing over the biggest coin that fits does not always use
;   the fewest coins. The chart compares that "greedy" count (orange)
;   with the true best count (green) for every amount up to 24.
;
; HOW TO USE
;   Press Run. Change the coin lists in the last lines to explore.
;
; CONCEPTS YOU WILL LEARN
;   * tree recursion: use the first coin, or never use it again
;   * a greedy method, and a case where it fails
;   * dynamic programming: building answers for small amounts first
;
; THINGS TO TRY
;   * Chart the coins [25 10 5 1] (biggest first). Is greedy ever wrong?
;   * Count the ways to make 50 cents. Is it half of 292?
; ============================================================

; Ways to make an amount from a list of coins. Either we use the
; first coin at least once, or we never use it: those two groups
; never overlap and together cover every way.
to ways :amount :coins
  if :amount = 0 [output 1]
  if or :amount < 0 emptyp :coins [output 0]
  output (ways :amount - first :coins :coins) + (ways :amount butfirst :coins)
end

; Greedy: take the biggest coin that fits, again and again.
; The coins must be listed biggest first.
to greedy :amount :coins
  if :amount = 0 [output 0]
  if (first :coins) > :amount [output greedy :amount butfirst :coins]
  output 1 + greedy :amount - first :coins :coins
end

; Best: fill a table of the fewest coins for 0, 1, 2, ... up to the
; amount. Each entry looks back at entries already worked out.
to besttable :top :coins
  localmake "best (array :top + 1 0)
  setitem 0 :best 0
  for [a 1 :top] [
    localmake "low 1000
    foreach :coins [
      if ? <= :a [
        localmake "try 1 + item :a - ? :best
        if :try < :low [make "low :try]
      ]
    ]
    setitem :a :best :low
  ]
  output :best
end

to bar :x :height :color
  if :height = 0 [stop]
  penup setxy :x -200 setheading 0 pendown
  filled :color [repeat 2 [forward 40 * :height right 90 forward 11 right 90]]
end

to chart :top :coins
  localmake "best besttable :top :coins
  for [a 1 :top] [
    localmake "x -360 + 30 * (:a - 1)
    localmake "g greedy :a :coins
    bar :x :g [240 150 40]
    bar :x + 12 item :a :best [60 170 90]
    penup setxy :x -222 setpencolor 0 label :a
    if :g > item :a :best [print (sentence [Greedy fails for] :a [cents. It uses] :g [coins but] item :a :best [are enough.])]
  ]
  penup setxy -360 230 label (sentence [Coins:] :coins [and the bars show greedy in orange, best in green])
end

clearscreen hideturtle
setbackground [250 248 240]
setlabelheight 13
print (sentence [Ways to make 100 cents:] ways 100 [50 25 10 5 1])
chart 24 [4 3 1]
