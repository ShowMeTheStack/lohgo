; ============================================================
; TITLE:    Odd Numbers Make Squares
; CATEGORY: Number Theory
; LEVEL:    Beginner
; TAGS:     odd numbers, square numbers, proof without words, animation
; SUMMARY:  Builds a square out of L-shaped layers of 1, 3, 5, 7 ... tiles to show that adding up odd numbers always gives a square number.
; ============================================================
;
; WHAT IT DOES
;   1 = 1, 1 + 3 = 4, 1 + 3 + 5 = 9, 1 + 3 + 5 + 7 = 16. The answers
;   are always square numbers! The picture shows why. Start with one
;   tile. Wrap an L of 3 tiles around it and you have a 2 by 2 square.
;   Wrap an L of 5 tiles around that: 3 by 3. Each new L is the next odd
;   number, and each one turns a square into the next bigger square.
;   A picture like this is called a "proof without words".
;
; HOW TO USE
;   Press Run and watch the layers appear. Change :LAYERS (up to about
;   10) and :SIDE to make it bigger or smaller.
;
; CONCEPTS YOU WILL LEARN
;   * FILLED to paint tiles
;   * a FOR loop inside another FOR loop
;   * keeping a running total
;   * the odd number in layer k is 2k - 1
;
; THINGS TO TRY
;   * Use the even numbers 2, 4, 6, 8 instead. The shape becomes a
;     rectangle, not a square. How wide and how tall is it?
;   * Slow it down with a bigger WAIT and count along out loud.
; ============================================================

; One square tile with its lower-left corner at column :c, row :r.
to tile :c :r :color
  penup setxy :left + (:c - 1) * :side :bottom + (:r - 1) * :side
  setheading 0 setpencolor [255 255 255] setpensize 2
  pendown
  filled :color [repeat 4 [forward :side right 90]]
  penup
end

; Layer k is an L: the top row of the k by k square plus its right
; column. Together they hold k + k - 1 = 2k - 1 tiles, an odd number.
to layer :k :color
  for [c 1 :k] [tile :c :k :color wait 3]
  ; careful: for k = 1 this would be FOR [r 0 1], which counts UP
  if :k > 1 [for [r :k - 1 1] [tile :k :r :color wait 3]]
end

to build
  localmake "total 0
  localmake "sum.text []
  for [k 1 :layers] [
    localmake "odd 2 * :k - 1
    localmake "color item 1 + remainder (:k - 1) 8 :colors
    layer :k :color
    make "total :total + :odd
    make "sum.text ifelse :k = 1 [(list :odd)] [(sentence :sum.text "+ :odd)]
    ; write the growing sum on the right, in the same color as the layer
    penup setxy -20 120 - 30 * :k setpencolor :color
    label (sentence :sum.text "= :total "= :k "x :k)
    print (sentence :sum.text "= :total)
    wait 20
  ]
end

make "layers 8
make "side 40
make "left -360
make "bottom -230
make "colors [[230 70 60] [240 150 30] [230 200 40] [90 180 70] [40 160 160] [60 110 220] [130 80 200] [200 70 160]]

clearscreen hideturtle
setbackground [250 250 245]
setlabelheight 13
build
